<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bolok</AssemblyName>
    <RootNamespace>Bolok</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <!-- 개발 빌드는 0.0.0 (자동 업데이트 안 함). 릴리스는 깃허브 액션이 태그 버전을 넣는다 -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\sprites.png" LogicalName="sprites.png" />
    <EmbeddedResource Include="..\assets\sprites.json" LogicalName="sprites.json" />
    <EmbeddedResource Include="..\assets\lang.json" LogicalName="lang.json" />
    <!-- 캐릭터는 기본 햄스터만 넣는다. 나머지는 알이 생길 때 저장소에서 받는다 (manifest: 크기·sha256 목록) -->
    <EmbeddedResource Include="..\assets\pets\hamster.png" LogicalName="pets/hamster.png" />
    <EmbeddedResource Include="..\assets\pets\hamster.json" LogicalName="pets/hamster.json" />
    <EmbeddedResource Include="..\assets\pets\manifest.json" LogicalName="pets/manifest.json" />
  </ItemGroup>

</Project>
